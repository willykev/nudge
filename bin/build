#!/bin/sh
set -eu

# The tree's real path, symlinks resolved, which is how qmake sees it.
ROOT="$(CDPATH= cd -P -- "$(dirname -- "$0")/.." && pwd -P)"
mkdir -p "$ROOT/build"
cd "$ROOT/build"

# Without a cache file of its own, qmake runs any .qmake.conf, .qmake.cache,
# .qmake.super or .qmake.stash it finds in a directory above the tree, such
# as one another user left in /tmp. Pinning the cache here stops that search,
# given by its real path too, in case the build directory is a symlink.
[ -e .qmake.cache ] || : > .qmake.cache
qmake6 -cache "$(pwd -P)/.qmake.cache" "$ROOT/nudge.pro"
make -j"$(nproc)"

echo "Built $ROOT/build/nudge"
