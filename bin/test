#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
mkdir -p "$ROOT/build/tests"
cd "$ROOT/build/tests"

# Without a cache file of its own, qmake runs any .qmake.conf, .qmake.cache,
# .qmake.super or .qmake.stash it finds in a directory above the tree, such
# as one another user left in /tmp. Pinning the cache here stops that search.
[ -e .qmake.cache ] || : > .qmake.cache
qmake6 -cache "$ROOT/build/tests/.qmake.cache" "$ROOT/tests/nudge_tests.pro"
make -s -j"$(nproc)"
QT_QPA_PLATFORMTHEME=generic QT_QUICK_BACKEND=software QT_QPA_PLATFORM=offscreen ./nudge_tests "$@"
