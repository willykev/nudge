# Not "nudge": the AUR has an unrelated Electron app by that name, and yay
# (omarchy update) would try to "upgrade" this package to it.
pkgname=nudge-reminders
pkgver=0.1.1
pkgrel=1
pkgdesc='Reminders and to-do lists for the Omarchy desktop'
arch=('x86_64' 'aarch64')
url='https://github.com/willykev/nudge'
license=('MIT')
options=('!debug')
# Same binary path as the AUR's nudge, and replaces this app's old package name.
conflicts=('nudge')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland')
makedepends=('gcc' 'make')
# This recipe builds a checkout. bin/release also produces a standalone
# download recipe with a versioned source URL and SHA-256 checksum.
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/nudge "$pkgdir/usr/bin/nudge"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/nudge.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/nudge.svg"
  install -Dm644 "$startdir/nudge.desktop" "$pkgdir/usr/share/applications/nudge.desktop"
  # Sends the alerts while no window is open. It is off until turned on from
  # the window (B) or with `nudge background on`.
  install -Dm644 "$startdir/nudge.service" "$pkgdir/usr/lib/systemd/user/nudge.service"
}
